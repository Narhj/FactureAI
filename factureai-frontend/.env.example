# Copia este archivo a ".env" (desarrollo local) y/o configura la misma
# variable en Vercel (produccion). No subas tu ".env" real a GitHub.

# Emulador local de Firebase (valor por defecto si no se define nada):
# VITE_API_BASE_URL=http://127.0.0.1:5001/practicefactureia/us-central1/api

# Backend desplegado en Render.com (reemplaza por tu URL real, la que te
# da Render al crear el servicio; ver render-backend/README.md):
# VITE_API_BASE_URL=https://factureai-backend.onrender.com
VITE_API_BASE_URL=
