{
  "info": {
    "name": "FactureAI - Servicios del Proyecto (GA7-220501096-AA5-EV03)",
    "description": "Coleccion para probar los servicios de Registro/Login (AA5-EV01) y los nuevos servicios de Proyectos y Facturas (AA5-EV03). Ajusta {{base_url}} con la URL de tu funcion (emulador o desplegada).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": ""
    },
    {
      "key": "proyecto_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Autenticacion (AA5-EV01)",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": "{{base_url}}/register"
          }
        },
        {
          "name": "Login correcto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": "{{base_url}}/login"
          }
        }
      ]
    },
    {
      "name": "Proyectos",
      "item": [
        {
          "name": "Crear proyecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('proyecto_id', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"cliente\": \"\",\n  \"descripcion\": \"\"\n}"
            },
            "url": "{{base_url}}/proyectos"
          }
        },
        {
          "name": "Listar proyectos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/proyectos"
          }
        },
        {
          "name": "Ver detalle de proyecto",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/proyectos/{{proyecto_id}}"
          }
        },
        {
          "name": "Editar proyecto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"\"\n}"
            },
            "url": "{{base_url}}/proyectos/{{proyecto_id}}"
          }
        },
        {
          "name": "Ver proyecto inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/proyectos/idQueNoExiste"
          }
        },
        {
          "name": "Eliminar proyecto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/proyectos/{{proyecto_id}}"
          }
        }
      ]
    },
    {
      "name": "Facturas",
      "item": [
        {
          "name": "Registrar factura manual",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proveedor\": \"\",\n  \"numero\": \"\",\n  \"monto\": ,\n  \"proyectoId\": \"{{proyecto_id}}\"\n}"
            },
            "url": "{{base_url}}/facturas"
          }
        },
        {
          "name": "Listar todas las facturas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/facturas"
          }
        },
        {
          "name": "Listar facturas de un proyecto",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/proyectos/{{proyecto_id}}/facturas"
          }
        },
        {
          "name": "Registrar factura con proyecto inexistente (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proveedor\": \"\",\n  \"numero\": \"\",\n  \"monto\": ,\n  \"proyectoId\": \"idQueNoExiste\"\n}"
            },
            "url": "{{base_url}}/facturas"
          }
        }
      ]
    }
  ]
}
